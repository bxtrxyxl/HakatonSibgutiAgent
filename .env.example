# --- LLM (OpenAI-совместимый) ---
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=your-chat-model

# --- Эмбеддинги (OpenAI-совместимый) ---
EMBED_BASE_URL=https://api.example.com/v1
EMBED_API_KEY=sk-replace-me
EMBED_MODEL=your-embed-model

# --- Поиск ---
TOP_K=6

# --- Публичная ссылка через ngrok (start-public.bat) ---
# Токен с https://dashboard.ngrok.com/get-started/your-authtoken
# Нужен только для start-public.bat; хранится локально и не коммитится.
NGROK_AUTHTOKEN=

# --- Защита тяжёлых и админ-операций ---
# Если пусто — локальный режим без токена; для публичного запуска задайте секретную строку.
ADMIN_TOKEN=
ADMIN_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_WINDOW_SEC=60
